# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---------- 运行时产物 ----------
# 日志与报文记录（按时间自动生成）
logs/
data_recordings/
reports/

# 导入功能导出的解析结果（运行时生成）；保留示例文件供新手体验
resources/odx/
resources/a2l/*
!resources/a2l/sample_demo.a2l

# 用户项目文件（含个人设备配置）
*.dproj

# ---------- 二进制/私有资产 ----------
# 安全算法 DLL 通常为 OEM 私有产物，不随仓库发布；
# Python 示例算法（*.py）保留在仓库中
plugins/**/*.dll

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---------- 本地调试产物与临时脚本 ----------
debug.log
.coverage
htmlcov/
/_*.py
/_*.txt
*.orig

# ---------- OEM 项目资产（调查表存档/用户序列，不公开） ----------
resources/did_definitions/fb63_vcdm_survey.json
resources/sequences/Read_F15B.json
resources/sequences/test1.json
resources/sequences/2E-F101_*.json
